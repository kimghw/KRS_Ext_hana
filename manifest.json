{
  "manifest_version": 3,
  "name": "KRS WORKSPACE",
  "version": "0.4.0",
  "description": "KRS eclass 회의실·차량을 사이드 패널에서 조회·예약하고, HR 근태 신청서를 올립니다.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://eclass.krs.co.kr/*",
    "https://hr.krs.co.kr/*",
    "https://api.anthropic.com/*",
    "http://localhost:5003/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://eclass.krs.co.kr/*"],
      "js": ["home.js", "people.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://eclass.krs.co.kr/*"],
      "js": ["afterpage.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js"],
      "matches": ["https://eclass.krs.co.kr/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "KRS WORKSPACE 패널 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
